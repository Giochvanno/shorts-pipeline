# Copy to .env and fill in. Never commit .env.
# Only keys live here. Model IDs, voices and providers live in config/*.yaml.
# Fake adapters need none of these: tests and CI run with an empty .env.

# --- LLM ---------------------------------------------------------------------
# Primary path: Claude Agent SDK / `claude -p` on Claude Pro credits (log in once
# with the Claude Code CLI; no key needed here). This key is the fallback only.
ANTHROPIC_API_KEY=

# --- Voice -------------------------------------------------------------------
ELEVENLABS_API_KEY=

# --- Images (FLUX); provider is chosen in config ------------------------------
FAL_KEY=
REPLICATE_API_TOKEN=

# --- Stock -------------------------------------------------------------------
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Telegram (approval bot + alerts) ----------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- YouTube Data API (OAuth files, kept outside git) ------------------------
YOUTUBE_CLIENT_SECRETS_FILE=secrets/client_secret.json
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json
